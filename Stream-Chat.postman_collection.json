{
  "info": {
    "name": "Stream-Chat API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",    "value": "http://localhost:8090" },
    { "key": "token",       "value": "" },
    { "key": "token_pedro", "value": "" },
    { "key": "group_id",    "value": "" },
    { "key": "ana_id",      "value": "" },
    { "key": "pedro_id",    "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Registrar Ana",
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ana\",\n  \"password\": \"123456\",\n  \"email\": \"ana@chat.local\"\n}"
            }
          }
        },
        {
          "name": "Registrar Pedro",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "if (r.id) pm.collectionVariables.set('pedro_id', r.id);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"pedro\",\n  \"password\": \"123456\",\n  \"email\": \"pedro@chat.local\"\n}"
            }
          }
        },
        {
          "name": "Login Ana (guarda token)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "if (r.token) pm.collectionVariables.set('token', r.token);",
              "if (r.userId) pm.collectionVariables.set('ana_id', r.userId);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ana\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Login Pedro (guarda token_pedro)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "if (r.token) pm.collectionVariables.set('token_pedro', r.token);",
              "if (r.userId) pm.collectionVariables.set('pedro_id', r.userId);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"pedro\",\n  \"password\": \"123456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Grupos",
      "item": [
        {
          "name": "Crear grupo (guarda group_id)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "if (r.id) pm.collectionVariables.set('group_id', r.id);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [
              {"key":"Content-Type","value":"application/json"},
              {"key":"Authorization","value":"Bearer {{token}}"}
            ],
            "url": "{{base_url}}/api/v1/groups",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"GrupoA\"\n}"
            }
          }
        },
        {
          "name": "Agregar miembro al grupo",
          "request": {
            "method": "POST",
            "header": [
              {"key":"Content-Type","value":"application/json"},
              {"key":"Authorization","value":"Bearer {{token}}"}
            ],
            "url": "{{base_url}}/api/v1/groups/{{group_id}}/members",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"{{target_user_id}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Mensajes",
      "item": [
        {
          "name": "Enviar mensaje",
          "request": {
            "method": "POST",
            "header": [
              {"key":"Content-Type","value":"application/json"},
              {"key":"Authorization","value":"Bearer {{token}}"}
            ],
            "url": "{{base_url}}/api/v1/groups/{{group_id}}/messages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"¡Hola a todos desde Postman!\"\n}"
            }
          }
        },
        {
          "name": "Obtener historial de mensajes",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/groups/{{group_id}}/messages?page=0&size=20",
              "query": [
                {"key":"page","value":"0"},
                {"key":"size","value":"20"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Salud y métricas",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/actuator/health"
          }
        },
        {
          "name": "Typing states activos",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{token}}"}],
            "url": "{{base_url}}/actuator/metrics/typing_states_active"
          }
        },
        {
          "name": "Mensajes publicados (success)",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{token}}"}],
            "url": "{{base_url}}/actuator/metrics/messages.published.success"
          }
        },
        {
          "name": "Mensajes persistidos (analytics)",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{token}}"}],
            "url": "{{base_url}}/actuator/metrics/analytics.messages.persisted"
          }
        }
      ]
    }
  ]
}
