# ── Base de datos ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/streamchat
DB_USERNAME=streamchat
DB_PASSWORD=changeme
POSTGRES_DB=streamchat
POSTGRES_USER=streamchat
POSTGRES_PASSWORD=changeme

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-base64-encoded-secret
JWT_EXPIRATION_MS=86400000

# ── RabbitMQ ───────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=streamchat
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=streamchat

# ── Kafka ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
