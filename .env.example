# Valores de ejemplo: no poner secretos reales aquí.
DB_NAME=streamchat
DB_URL=jdbc:postgresql://localhost:5432/streamchat
DB_USERNAME=streamchat
DB_PASSWORD=changeme
JWT_SECRET=change-this-to-a-random-256-bit-base64-encoded-secret
JWT_EXPIRATION_MS=86400000

# Presencia / typing
PRESENCE_TYPING_TTL_MS=5000
PRESENCE_EXPIRATION_SCAN_MS=2000
# local = adaptador local temporal; kafka = adaptador que implementará P2
PRESENCE_PUBLISHER=local
